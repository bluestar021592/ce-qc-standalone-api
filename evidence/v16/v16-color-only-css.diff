diff --git "a/public\\v16-blue-white-colors.css" "b/public\\v16-blue-white-colors.css"
new file mode 100644
index 0000000..59d5d5a
--- /dev/null
+++ "b/public\\v16-blue-white-colors.css"
@@ -0,0 +1,77 @@
+:root {
+  --qc-page-bg: #F4F7FB;
+  --qc-main-panel: #FFFFFF;
+  --qc-main-panel-soft: #F8FBFF;
+  --qc-sidebar: #052B52;
+  --qc-sidebar-section: #07396B;
+  --qc-active-nav: #1677FF;
+  --qc-topbar: #FFFFFF;
+  --qc-primary-blue: #1677FF;
+  --qc-text-primary: #18324F;
+  --qc-text-secondary: #72859D;
+  --qc-border: #D9E4F2;
+  --qc-grid: #E8EFF7;
+  --qc-success: #17A673;
+  --qc-warning: #F28B21;
+  --qc-danger: #E65368;
+  --qc-purple: #7454E8;
+  --qc-cyan: #21A6B8;
+  --qc-shadow: 0 2px 10px rgba(31, 78, 121, .08);
+}
+
+html,
+body,
+.app-stage,
+.main-content { background: var(--qc-page-bg); color: var(--qc-text-primary); }
+.sidebar { background: var(--qc-sidebar); border-color: #174E7C; box-shadow: 3px 0 14px rgba(9, 49, 85, .14); }
+.sidebar-brand { background: var(--qc-sidebar); border-color: rgba(255, 255, 255, .14); }
+.sidebar-brand img { background: #FFFFFF; }
+.brand-copy strong { color: #FFFFFF; }
+.brand-copy small { color: #B9D4EC; }
+.side-group { background: var(--qc-sidebar-section); border-color: rgba(255, 255, 255, .08); }
+.side-link,
+.side-group-title,
+.side-sub { color: #DCEBFA; }
+.side-link:hover,
+.side-group-title:hover,
+.side-link.active,
+.side-sub:hover,
+.side-sub.active { background: var(--qc-active-nav); color: #FFFFFF; }
+.sidebar-collapse { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .20); color: #FFFFFF; }
+.topbar { background: var(--qc-topbar); border-color: var(--qc-border); box-shadow: 0 2px 8px rgba(31, 78, 121, .05); }
+.topbar h1,
+.top-user,
+.top-date,
+.cycle-select { color: var(--qc-text-primary); }
+.panel,
+.pixel-panel,
+.pixel-chart-card,
+.business-summary-card,
+.core-summary-card { background: var(--qc-main-panel); border-color: var(--qc-border); box-shadow: var(--qc-shadow); }
+.business-summary-card { background: var(--qc-main-panel-soft); }
+.business-summary-card span,
+.business-summary-card b,
+.core-summary-card span,
+.core-summary-card b,
+.pixel-panel-title,
+.pixel-chart-title { color: var(--qc-text-primary); }
+.business-summary-card small,
+.business-summary-card em,
+.core-summary-card small,
+.pixel-panel-title small,
+.muted-note { color: var(--qc-text-secondary); }
+.core-summary-card i { background: var(--qc-primary-blue); box-shadow: 0 0 0 5px #E9F3FF; }
+.core-summary-card:hover { background: #F1F7FF; box-shadow: inset 0 0 0 1px #9FC8EF; }
+.shopee-special-grid.detailed section,
+.dispatch-group,
+.pixel-carry-wrap,
+.compact-table th,
+.compact-table td { border-color: var(--qc-border); }
+.shopee-special-grid.detailed section header { background: #EAF4FF; color: #125E9E; }
+.pixel-chart-card line,
+.pixel-chart-card .grid-line { stroke: var(--qc-grid); }
+.pixel-chart-card text { fill: var(--qc-text-secondary); }
+.btn.primary { background: var(--qc-primary-blue); border-color: var(--qc-primary-blue); color: #FFFFFF; }
+.status-good { color: var(--qc-success); }
+.status-warning { color: var(--qc-warning); }
+.status-danger { color: var(--qc-danger); }
