# CE OTWMS base URL
CE_BASE_URL=https://otwms.cambodianexpress.com

# Local server and SQLite database
HOST=0.0.0.0
PORT=5177
DATA_DIR=D:\CE CCSL金边数据库
DB_FILE=D:\CE CCSL金边数据库\ce_qc_monitor.db
PUBLIC_BASE_URL=http://127.0.0.1:5177

# CE登录基础认证。系统页面使用账号密码登录后，会自动保存access_token/refresh_token到本地token目录。
# Authorization 例如：Basic czFi...
CE_AUTHORIZATION=

# 下面两项仅保留为开发兼容，不作为正式日常使用要求。
CE_BLADE_AUTH=
CE_COOKIE=

# 语言
CE_LANGUAGE=zh

# 批次控制：先保守，稳定后再放大
ORDER_BATCH_SIZE=350
TRACK_BATCH_SIZE=50
TRACK_CONCURRENCY=1
REQUEST_TIMEOUT_MS=45000
