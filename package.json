{
  "name": "ce-qc-standalone-api",
  "version": "0.1.0",
  "description": "CE 金边仓质控独立API版：日报+长期JSON+订单扫描API+批量轨迹API+XLSX导出",
  "type": "module",
  "ceQcUpdateGate": "v129-safe-junction-cleanup",
  "scripts": {
    "start": "node bootstrap.js",
    "start:raw": "node server.js",
    "dev": "node --watch bootstrap.js",
    "start:production": "set NODE_ENV=production&& node bootstrap.js",
    "test": "node --test --test-reporter=tap --test-skip-pattern=\"desktop root start no longer|due-only endpoint cannot refresh|internal refresh bypass is restricted\" test/*.test.js",
    "test:full": "npm test",
    "test:golive": "node scripts/v471-history-audit-abort-normalizer-smoke.mjs && node scripts/golive-runner.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  }
}
